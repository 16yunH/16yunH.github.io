\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cv-style}[2026/09/06 Bilingual academic CV]
\RequirePackage[no-math]{fontspec}
\RequirePackage{xeCJK}
\RequirePackage[a4paper,left=42bp,right=42bp,top=30bp,bottom=47bp,footskip=25bp]{geometry}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{enumitem}
\RequirePackage{needspace}
\RequirePackage{fancyhdr}
\RequirePackage{etoolbox}
\RequirePackage[unicode]{hyperref}
% TeX-distributed Latin fonts and bundled open CJK TrueType fonts.
\setmainfont{texgyreheros-regular.otf}[
  BoldFont=texgyreheros-bold.otf,
  ItalicFont=texgyreheros-italic.otf,
  BoldItalicFont=texgyreheros-bolditalic.otf]
\setCJKmainfont{NotoSansSC-Regular.ttf}[Path=fonts/,BoldFont=NotoSansSC-Bold.ttf]
\definecolor{CVBlue}{HTML}{156082}
\definecolor{CVInk}{HTML}{202B33}
\definecolor{CVGrey}{HTML}{52606B}
\definecolor{CVLine}{HTML}{D7DFE4}
\hypersetup{colorlinks=true,urlcolor=CVBlue,linkcolor=CVBlue,pdfauthor={Yun Hong}}
\setlength{\parindent}{0pt}
\setlength{\parskip}{3bp}
\setlength{\emergencystretch}{1.5em}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0.4pt}
\renewcommand{\footrule}{\hbox to\headwidth{\color{CVLine}\leaders\hrule height \footrulewidth\hfill}}
\newcommand{\cvsmall}{\fontsize{8.5bp}{12bp}\selectfont\color{CVGrey}}
\newcommand{\cvsetup}[1]{%
  \color{CVInk}%
  \ifstrequal{#1}{zh}{%
    \fontsize{10bp}{15bp}\selectfont
    \fancyfoot[L]{{\cvsmall 更新日期：\CVUpdated}}%
    \fancyfoot[R]{{\cvsmall 洪运 | 简历 | \thepage}}%
  }{%
    \fontsize{9.5bp}{13.5bp}\selectfont
    \fancyfoot[L]{{\cvsmall Updated: \CVUpdated}}%
    \fancyfoot[R]{{\cvsmall Yun Hong | Curriculum Vitae | \thepage}}%
  }%
}
\newcommand{\cvheader}[2]{%
  \noindent\begin{minipage}[c]{0.84\linewidth}
    {\fontsize{28bp}{33bp}\selectfont\color{CVBlue}#1\par}
    \vspace{4bp}
    {\cvsmall #2\par
    \href{mailto:\CVEmail}{\CVEmail} | \CVPhone\par
    \href{\CVWebsite}{\CVWebsiteLabel} | \href{\CVGitHub}{\CVGitHubLabel}\par}
  \end{minipage}\hfill
  \begin{minipage}[c]{0.12\linewidth}
    \includegraphics[width=55bp]{\CVPortrait}
  \end{minipage}\par\vspace{9bp}%
}
\newcommand{\cvsection}[1]{%
  \par\addvspace{10bp}\Needspace{55bp}%
  {\fontsize{13bp}{18bp}\selectfont\color{CVBlue}#1\par}
  \nobreak\vspace{2bp}{\color{CVBlue}\hrule height .55bp}\nobreak\vspace{7bp}%
}
\newenvironment{cventry}[3]{%
  \par\noindent\begin{minipage}{\linewidth}
  \begin{minipage}[t]{\dimexpr\linewidth-146bp\relax}\vspace{0pt}
    {\fontsize{10.5bp}{14.5bp}\selectfont\bfseries #1\par}
  \end{minipage}\hfill
  \begin{minipage}[t]{134bp}\vspace{0pt}
    {\cvsmall #2\par}
  \end{minipage}\par\vspace{2bp}%
  {\cvsmall #3\par}%
}{\end{minipage}\par\addvspace{6bp}}
\newenvironment{cvitems}{%
  \begin{itemize}[leftmargin=9bp,labelsep=3bp,itemsep=2bp,topsep=2bp,parsep=0pt,partopsep=0pt,label=\textbullet]
}{\end{itemize}}
\newcommand{\cvdetail}[2]{\textbf{#1:} #2\par}
\endinput
